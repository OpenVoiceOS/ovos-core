#!/bin/sh

# use OVOS alpha channel
OVOS_CHANNEL="alpha"

if [ "$OVOS_CHANNEL" = "alpha" ]; then
    PIP_PRE=1
    UV_PRERELEASE="allow"
fi


BASE_URL="https://raw.githubusercontent.com/OpenVoiceOS/ovos-releases/refs/heads/main"

PIP_CONSTRAINT="${BASE_URL}/constraints-${OVOS_CHANNEL}.txt"
UV_CONSTRAINT="${BASE_URL}/constraints-${OVOS_CHANNEL}.txt"